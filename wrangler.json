{
  "$schema": "node_modules/wrangler/config-schema.json",
  "send_metrics": false,
  "name": "d1-comments-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB_BINDING",
      "database_name": "d1-comments-api",
      "database_id": "84349364-c34f-495c-a6bc-c13c4c7589cb"
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *", "*/5 * * * *", "*/30 * * * *", "0 * * * *"]
  }
}
